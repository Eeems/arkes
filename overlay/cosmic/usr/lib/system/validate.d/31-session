#!/bin/bash
set -euo pipefail

wait_class() {
  end=$((SECONDS + 60))
  while [ "$SECONDS" -lt "$end" ]; do
    for id in $(loginctl list-sessions --no-legend --no-pager | awk '{print $1}'); do
      if [ "$(loginctl show-session "$id" -p Class --value)" = "$1" ]; then
        return 0
      fi
    done
    sleep 1
  done
  return 1
}

if ! wait_class greeter; then
  echo "timed out waiting for the greeter session" >&2
  exit 1
fi

if [ ! -d /ostree ] && ! wait_class manager; then
  echo "timed out waiting for the manager session" >&2
  exit 1
fi
