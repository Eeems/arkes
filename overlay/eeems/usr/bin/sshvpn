#!/bin/bash
set -e
if [ "$EUID" -ne 0 ]; then
  exec sudo "$0" "$@"
fi
log() {
  echo "$@" 1>&2
}
dns_nameservers() {
  awk '/^nameserver[[:space:]]+/ {print $2}' /etc/resolv.conf |
    grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' |
    grep -v '^127\.' |
    awk '!seen[$0]++'
}
up() {
  log "Setting up vpn..."
  local args=()
  local dns_flags=()
  local list=""
  local net
  local ns
  local nonlocal=()
  while read -r net; do
    args+=("--exclude" "$net")
  done < <(ip route | awk '$1 ~ /\// && $2 == "dev" {print $1}')
  if [ -n "$SSHVPN_TUNNEL_DNS" ]; then
    for ns in $(dns_nameservers); do
      if ip route get "$ns" | grep -q ' via '; then
        nonlocal+=("$ns")
      fi
    done
    if [ ${#nonlocal[@]} -gt 0 ]; then
      list=$(printf '%s,' "${nonlocal[@]}" | sed 's/,$//')
      dns_flags=("--ns-hosts" "$list" "--to-ns" "${nonlocal[0]}")
    fi
  fi
  sshuttle \
    --ssh-cmd 'sudo -u eeems ssh' \
    --remote "$1" \
    "${dns_flags[@]}" \
    "${args[@]}" \
    0/0 >/dev/null &
}
down() {
  log "Stopping vpn..."
  local jobs_list
  jobs_list=$(jobs -p)
  if [ -n "$jobs_list" ]; then
    kill $jobs_list 2>/dev/null || true
    wait $jobs_list 2>/dev/null || true
  fi
  log "Stopped."
}
ipaddr() {
  log "Wating for ip..."
  ret=1
  while [ $ret != 0 ]; do
    set +e
    ip=$(curl -s4 icanhazip.com)
    ret=$?
    set -e
  done
  log -n "ipv4: "
  echo "$ip"
}
wait_for_tunnel_ip() {
  local attempts=30
  local new_ip=""
  while [ $attempts -gt 0 ]; do
    set +e
    new_ip=$(curl -s4 --max-time 5 icanhazip.com)
    local ret=$?
    set -e
    if [ "$ret" -eq 0 ] && [ -n "$new_ip" ] && [ "$new_ip" != "$1" ]; then
      log -n "ipv4: "
      echo "$new_ip"
      return 0
    fi
    attempts=$((attempts - 1))
    [ $attempts -gt 0 ] && sleep 2
  done
  log "WARNING: tunnel seems broken, exit ip still $1"
  return 1
}
help() {
  log "Usage: $0 <host>"
}
main() {
  if [ $# -ne 1 ]; then
    help
    return 1
  fi
  ipaddr 1>&2
  trap down EXIT
  up "$1"
  wait_for_tunnel_ip "$ip" || exit 1
  log "VPN connected!"
  wait $(jobs -p)
}
main "$@"
