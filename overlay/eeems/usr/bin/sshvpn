#!/bin/bash
set -e
if [ "$EUID" -ne 0 ]; then
  exec sudo "$0" "$@"
fi
log() {
  echo "$@" 1>&2
}
fw_remove() {
  if ! err=$(iptables -D "$@" 2>&1); then
    grep -q "does a matching rule exist in that chain?" <<<"$err" ||
      {
        echo "$err" 1>&2
        return 1
      }
  fi
}
up() {
  log "Setting up kernel..."
  sysctl net.ipv4.conf.all.rp_filter=0 1>&2
  sysctl -w net.ipv4.ip_forward=1 1>&2
  log "Setting up networking..."
  if [ -n "$3" ]; then
    for ip in $4; do
      ip route add "$ip"/32 via "$3"
    done
  fi
  ip tuntap add mode tun dev tun0
  ip addr add 192.18.0.1/15 dev tun0
  ip link set dev tun0 up
  sysctl net.ipv4.conf.tun0.rp_filter=0 1>&2
  log "Setting up firewall..."
  iptables -A FORWARD -i tun0 -j ACCEPT
  iptables -A FORWARD -o tun0 -j ACCEPT
  log "Starting ssh connection..."
  sudo -u eeems ssh -TND 4711 "$1" >/dev/null &
  log "Starting vpn..."
  tun2socks \
    --device tun0 \
    --proxy socks5://localhost:4711 \
    --loglevel error \
    >/dev/null &
  ip route add default via 192.18.0.1 dev tun0 metric 1
}
down() {
  log "Stopping background jobs..."
  jobs_list=$(jobs -p)
  if [ -n "$jobs_list" ]; then
    kill $jobs_list 2>/dev/null || true
    wait $jobs_list 2>/dev/null || true
  fi
  if [ -n "$2" ]; then
    for ip in $3; do
      ip route del "$ip"/32 via "$2" || true
    done
  fi
  ip route del default via 192.18.0.1 dev tun0 metric 1 || true
  log "Stopping networking..."
  ip link set dev tun0 down
  ip tuntap del mode tun dev tun0
  fw_remove FORWARD -i tun0 -j ACCEPT
  fw_remove FORWARD -o tun0 -j ACCEPT
  log "Stopped."
}
ipaddr() {
  log "Wating for ip..."
  ret=1
  while [ $ret != 0 ]; do
    set +e
    ip=$(curl -s4 icanhazip.com)
    ret=$?
    set -e
  done
  log -n "ipv4: "
  echo "$ip"
}
help() {
  log "Usage: $0 <host>"
}
main() {
  if [ $# -ne 1 ]; then
    help
    return 1
  fi
  ipaddr 1>&2
  ssh_target=$(sudo -u eeems ssh -G "$1" | awk '$1 == "hostname" {print $2; exit}')
  ssh_ip=$(getent ahostsv4 "$ssh_target" | awk 'NR==1 {print $1}')
  ssh_ips=$(getent ahostsv4 "$ssh_target" | awk '{print $1}')
  ssh_gateway=
  if [ -n "$ssh_ip" ]; then
    ssh_gateway=$(ip route get "$ssh_ip" | sed -n 's/.* via \([^ ]*\).*/\1/p')
  fi
  up "$1" "$ssh_ip" "$ssh_gateway" "$ssh_ips"
  trap "down '$ssh_ip' '$ssh_gateway' '$ssh_ips'" EXIT
  ipaddr
  log "VPN connected!"
  wait $(jobs -p)
}
main "$@"
